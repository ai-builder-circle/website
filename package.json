{
  "name": "forge-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "serve": "serve out -l 4173 --no-clipboard",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:e2e",
    "images": "node scripts/optimize-images.mts",
    "predev": "npm run images",
    "prebuild": "npm run images",
    "brand-assets": "node scripts/brand-assets.mts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "serve": "14.2.6",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
